{
  "name": "Switchboard \u00b7 Watch: scheduled API pull & anomaly alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "9d5cea1b-cb91-4b47-99a4-b3192b7c95f3",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.frankfurter.app/latest?from=AUD&to=USD,EUR,GBP",
        "options": {
          "timeout": 15000
        }
      },
      "id": "5528304b-4de3-42e1-ade3-784774e47eef",
      "name": "Pull rates (public API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Compare with the previous run (workflow static data) and flag moves above a threshold.\nconst THRESHOLD_PCT = 0.5; // demo threshold; production would use a rolling baseline\nconst rates = $input.first().json.rates || {};\nconst staticData = $getWorkflowStaticData('global');\nconst prev = staticData.lastRates || {};\nconst anomalies = [];\nfor (const [ccy, val] of Object.entries(rates)) {\n  if (prev[ccy]) {\n    const pct = ((val - prev[ccy]) / prev[ccy]) * 100;\n    if (Math.abs(pct) >= THRESHOLD_PCT) anomalies.push({ ccy, prev: prev[ccy], now: val, pct: Number(pct.toFixed(3)) });\n  }\n}\nstaticData.lastRates = rates;\nreturn [{ json: { checked_at: new Date().toISOString(), base: 'AUD', rates, anomalies, has_anomaly: anomalies.length > 0, first_run: Object.keys(prev).length === 0 } }];"
      },
      "id": "c32717af-14ef-4ce8-9495-389718bb09eb",
      "name": "Detect anomalies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "acff1bd9-558d-48e9-9357-72239bb1786a",
              "leftValue": "={{ $json.has_anomaly }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1276052f-4922-4edc-b0f9-ba0e971c60ec",
      "name": "Any anomaly?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'claude-opus-5',\n  max_tokens: 400,\n  system: 'You write two-sentence plain-English alerts for a finance operations channel. No markdown.',\n  messages: [{ role: 'user', content: 'AUD exchange-rate moves since the last check (threshold 0.5%): ' + JSON.stringify($json.anomalies) + '. Explain what moved and one practical implication for a retailer paying overseas suppliers.' }]\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "d8d63b1e-7103-48bf-a8fa-c6021a5dfd02",
      "name": "Claude: explain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const det = $('Detect anomalies').first().json;\nconst res = $input.first().json;\nconst text = (res.content || []).filter(b => b.type === 'text').map(b => b.text).join('') || 'LLM explanation unavailable';\nreturn [{ json: { checked_at: det.checked_at, anomalies: det.anomalies, explanation: text, model: res.model || null } }];"
      },
      "id": "f7e4c889-e89e-426a-8afd-1ec1073d416a",
      "name": "Build alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SINK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "e35304b0-64e5-4cab-9c69-b603125c06bd",
      "name": "Log alert (sheet sink)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fc8b95ca-dc7c-4778-9282-f22d5b2f99ae",
              "leftValue": "={{ $env.SLACK_WEBHOOK_URL || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c92d1ed8-50da-4729-98f7-2dd54274fd8b",
      "name": "Slack configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1540,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':chart_with_upwards_trend: ' + $json.explanation }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "41520e0e-ede2-47bb-b64a-6c5e79ee3fcb",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SINK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ checked_at: $json.checked_at, base: $json.base, rates: $json.rates, anomalies: [], note: $json.first_run ? 'baseline stored' : 'no anomaly' }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "b45a2905-93e8-422f-a1ce-933894e00331",
      "name": "Log heartbeat (sheet sink)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        140
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Every 15 min": {
      "main": [
        [
          {
            "node": "Pull rates (public API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pull rates (public API)": {
      "main": [
        [
          {
            "node": "Detect anomalies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Detect anomalies": {
      "main": [
        [
          {
            "node": "Any anomaly?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any anomaly?": {
      "main": [
        [
          {
            "node": "Claude: explain",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log heartbeat (sheet sink)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude: explain": {
      "main": [
        [
          {
            "node": "Build alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build alert": {
      "main": [
        [
          {
            "node": "Log alert (sheet sink)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log alert (sheet sink)": {
      "main": [
        [
          {
            "node": "Slack configured?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack configured?": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  }
}